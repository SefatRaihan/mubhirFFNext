{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/ar-blog/layout,_N_T_/ar-blog/page,_N_T_/ar-blog"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/ar-blog/__PAGE__",
    "/ar-blog",
    "/_index",
    "/_head"
  ]
}